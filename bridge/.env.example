# LMC JEV Bridge — copy to .env.local or export in your shell.
# Never commit real secrets.
LMC_JEV_HOST=127.0.0.1
LMC_JEV_PORT=4317
LMC_WORKSPACE=
LMC_ALLOWED_ORIGIN=https://borngifted.github.io
LMC_EXEC_TIMEOUT_MS=600000
# Optional overrides if binaries are not on PATH:
JEV_BIN=jev
JEV_CLAUDE_BIN=jev-claude
JEV_CODEX_BIN=jev-codex
